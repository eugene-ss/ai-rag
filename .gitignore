# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Environment / secrets
.env
.env.local
*.pem
credentials.json

# Data (raw and derived stay out of git; only the layout is tracked)
data/**
!data/**/
!data/README.md
!data/**/.gitkeep

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Runtime
*.log
logs/**
!logs/.gitkeep
!logs/README.md
.cache/
tmp/
