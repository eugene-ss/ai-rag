# Copy to .env and edit. Never commit .env — it holds secrets.
#   cp .env.example .env
#
# Every RAG_* variable maps to a field on rag.settings.Settings.
# Full reference: docs/configuration.md

# --- environment -------------------------------------------------------------
# dev | test | docker | staging | production
# In staging/production, Settings refuses stub backends and header-trust auth.
RAG_ENV=dev
RAG_SERVICE_NAME=rag-api

# --- backend selection -------------------------------------------------------
# memory/hash/echo are deterministic stubs: no external services, dev only.
RAG_VECTOR_BACKEND=memory          # memory | qdrant
RAG_LEXICAL_BACKEND=memory         # memory | opensearch
RAG_EMBEDDING_BACKEND=hash         # hash   | openai
RAG_LLM_BACKEND=echo               # echo   | openai
RAG_CACHE_BACKEND=memory           # memory | redis
RAG_RERANKER=identity              # identity | cross_encoder

# --- index identity ----------------------------------------------------------
RAG_INDEX_VERSION=v1
RAG_COLLECTION_ALIAS=docs_live
RAG_COLLECTION_PREFIX=docs
RAG_DATA_ROOT=data
RAG_CONFIGS_ROOT=configs

# --- retrieval ---------------------------------------------------------------
RAG_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_RRF_K=60
RAG_DENSE_WEIGHT=1.0
RAG_LEXICAL_WEIGHT=1.0
RAG_REWRITE_ENABLED=true
RAG_MULTI_QUERY_ENABLED=false
RAG_MULTI_QUERY_COUNT=3
RAG_HYDE_ENABLED=false
# Below this fused score the system refuses instead of guessing.
RAG_REFUSAL_SCORE_THRESHOLD=0.01

# --- caching -----------------------------------------------------------------
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=3600
RAG_SEMANTIC_CACHE_ENABLED=true
RAG_SEMANTIC_CACHE_THRESHOLD=0.95

# --- models ------------------------------------------------------------------
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_HASH_EMBEDDING_DIMENSIONS=64
RAG_LLM_MODEL=gpt-4o-mini
# Comma-separated, tried in order after the primary model is exhausted.
RAG_LLM_FALLBACK_MODELS=
RAG_LLM_MAX_ATTEMPTS=3
RAG_LLM_TIMEOUT_SECONDS=30
RAG_LLM_MAX_OUTPUT_TOKENS=1024
RAG_LLM_TEMPERATURE=0.0

# --- security ----------------------------------------------------------------
# Fail closed: with no authenticator configured, every request gets 401.
RAG_AUTH_REQUIRED=true
# DEV ONLY. Trusting X-Tenant/X-Groups lets any caller pick their own ACL.
# Settings rejects this in staging/production.
RAG_AUTH_TRUST_HEADERS=true
# Production path: bearer token -> principal. See configs/auth.example.yaml.
# RAG_AUTH_TOKENS_FILE=configs/auth.yaml
RAG_DEFAULT_TENANT=default
RAG_PII_REDACTION_ENABLED=true

# --- api ---------------------------------------------------------------------
# Comma-separated origins; empty disables CORS entirely.
RAG_CORS_ALLOW_ORIGINS=
RAG_REQUEST_TIMEOUT_SECONDS=30
RAG_METRICS_ENABLED=true

# --- observability -----------------------------------------------------------
RAG_LOG_LEVEL=INFO
# Uncomment to also write logs/app.log
# RAG_LOG_DIR=logs

# --- credentials and endpoints ----------------------------------------------
# OPENAI_API_KEY=sk-...
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# OPENSEARCH_URL=http://localhost:9200
# REDIS_URL=redis://localhost:6379/0
