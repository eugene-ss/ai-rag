# Application
RAG_ENV=dev
RAG_INDEX_VERSION=v1
RAG_COLLECTION_ALIAS=docs_live
RAG_REFUSAL_SCORE_THRESHOLD=0.01
RAG_RRF_K=60
RAG_TOP_K=10
RAG_RERANK_TOP_K=5

# Caching
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=3600
RAG_SEMANTIC_CACHE_ENABLED=true
RAG_SEMANTIC_CACHE_THRESHOLD=0.95

# LLM resilience
RAG_LLM_MAX_ATTEMPTS=3
RAG_LLM_TIMEOUT_SECONDS=30

# Optional backends (only needed with extras)
# OPENAI_API_KEY=
# QDRANT_URL=http://localhost:6333
# OPENSEARCH_URL=http://localhost:9200

# Observability
RAG_LOG_LEVEL=INFO
# RAG_LOG_DIR=logs
