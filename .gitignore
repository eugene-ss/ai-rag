# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# Environment / secrets
.env
.env.local
*.pem
credentials.json
# Real token store; only the .example file is tracked.
configs/auth.yaml

# Data: raw and derived content stays out of git. Only the layout, the docs,
# and example golden sets are tracked.
data/**
!data/**/
!data/README.md
!data/**/README.md
!data/**/.gitkeep
!data/golden/*.example.jsonl

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Runtime
*.log
logs/**
!logs/.gitkeep
!logs/README.md
.cache/
tmp/
